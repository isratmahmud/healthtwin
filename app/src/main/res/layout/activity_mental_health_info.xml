<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">


                    <TextView
                        android:id="@+id/btn_sleep"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:text="Sleep"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:background="@drawable/tab_gray" />


                    <TextView
                        android:id="@+id/btn_fitness"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="-25dp"
                        android:text="Fitness"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:background="@drawable/tab_gray" />


                    <TextView
                        android:id="@+id/btn_nutrition"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="-25dp"
                        android:text="Nutrition"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:background="@drawable/tab_gray" />


                    <TextView
                        android:id="@+id/btn_mental_health"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="-25dp"
                        android:text="Mental health"
                        android:textColor="#212529"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/tab_style_selected" />


                    <TextView
                        android:id="@+id/btn_smoking"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="-25dp"
                        android:text="Smoking"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:background="@drawable/tab_gray" />


                    <TextView
                        android:id="@+id/btn_alcohol"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="-25dp"
                        android:text="Alchohol"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:background="@drawable/tab_gray" />

                </LinearLayout>
            </HorizontalScrollView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@android:color/black"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The 5-4-3-2-1 Grounding Technique: To calm anxiety, identify 5 things you see, 4 you can touch, 3 you hear, 2 you can smell, and 1 you can taste. \n\n Digital Boundaries: Set a tech-free hour before bed to reduce comparison-itus and the impact of negative news cycles. \n\nSocial Connection: Even a 5-minute phone call with a friend can significantly lower cortisol levels."
                        android:textColor="#212529"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2"
                        android:padding="16dp" />

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>


            <TextView
                android:id="@+id/link1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Caring your mental health"
                android:textColor="#1A0DAB"
                android:textSize="15sp"
                android:autoLink="all"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/link2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tips for better mental health"
                android:textColor="#1A0DAB"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/link3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9 Ways to Help You Stay Mentally Healthy"
                android:textColor="#1A0DAB"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/link4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Stress: Health and Wellbeing Tips"
                android:textColor="#1A0DAB"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/link5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coping with Stress: Strategies for 2026"
                android:textColor="#1A0DAB"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_blue_divider" />
    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="8dp"
        android:weightSum="5">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <ImageView
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:contentDescription="Home" />

        <ImageView
            android:id="@+id/btnHeart"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_simulation"
            android:contentDescription="Simulation" />

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_info_selected"
            android:contentDescription="Info" />

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:contentDescription="Profile" />
    </LinearLayout>

</RelativeLayout>